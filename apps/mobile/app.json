{
  "expo": {
    "name": "Kizuna HMS Mobile",
    "slug": "kizuna-hms-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0F766E"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kizuna.hospital.hms"
    },
    "android": {
      "package": "com.kizuna.hospital.hms"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    },
    "scheme": "kizunahms"
  }
}