# ==============================================================================
# AALAYAM MULTISPECIALITY HOSPITAL MANAGEMENT SYSTEM (HMS)
# Environment Configuration Template
# ==============================================================================

# Application Environment
NODE_ENV=development
HOSPITAL_NAME="Aalayam Multispeciality Hospital"
HOSPITAL_TAGLINE="Excellence in Care, Compassion in Healing"
HOSPITAL_CODE="AALAYAM"

# API Service Configuration
API_PORT=4000
API_HOST=localhost
API_BASE_URL="http://localhost:4000/api/v1"
CORS_ORIGINS="http://localhost:3000,http://localhost:8081,exp://localhost:8081"

# Database Configuration (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=[schema]
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aalayam_hms?schema=public"

# Authentication & Security
# Generate secure keys in production using: openssl rand -base64 32
JWT_SECRET="aalayam-enterprise-hms-jwt-access-secret-key-2026-very-secure"
JWT_EXPIRATION="15m"
JWT_REFRESH_SECRET="aalayam-enterprise-hms-jwt-refresh-secret-key-2026-very-secure"
JWT_REFRESH_EXPIRATION="7d"

# Web Client Configuration
WEB_PORT=3000
VITE_API_URL="http://localhost:4000/api/v1"
VITE_HOSPITAL_NAME="Aalayam Multispeciality Hospital"

# Mobile Client Configuration (Expo)
EXPO_PUBLIC_API_URL="http://10.0.2.2:4000/api/v1" # Android emulator loopback or LAN IP
EXPO_PUBLIC_HOSPITAL_NAME="Aalayam Multispeciality Hospital"

# Socket.IO Real-time Events
SOCKET_PORT=4000

# File Storage / AWS S3 / MinIO (Optional placeholder for DICOM & Lab Reports)
STORAGE_TYPE=local
STORAGE_LOCAL_PATH="./uploads"
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=aalayam-medical-records

# Notifications (Email/SMS Providers - Placeholders)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMS_GATEWAY_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
